# ─────────────────────────────────────────────────────────────────────────────
# Lumen — environment template
# Copy this file to `.env` and fill in real values. .env is gitignored.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production


# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lumen_db

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string used by the app. With docker compose the host is "postgres".
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lumen_db


# ── Sessions / cookies ──────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-32-byte-hex

# "true" only when serving over HTTPS. Leave false for local HTTP.
SECURE_COOKIES=false


# ── Google OAuth (optional) ─────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# ── SMTP / mail (optional) ──────────────────────────────────────────────────
# When unset, password-reset links are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Lumen <no-reply@lumen.localhost>

# Absolute URL the app is reachable at — used in email links.
PUBLIC_BASE_URL=


# ── Cloudflare Tunnel (optional, for serving Lumen on its own domain) ───────
# Leave both blank → `npm run demo` uses a random *.trycloudflare.com URL.
# To bind a real Lumen domain (lumen.app / lumen.tv / lumen.live / etc.):
#   dash.cloudflare.com → Zero Trust → Networks → Tunnels → create →
#   add a Public Hostname pointing at http://app:5000 → copy the token here.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_HOSTNAME=


# ── GitHub OAuth (optional) ─────────────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
