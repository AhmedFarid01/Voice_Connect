# ─────────────────────────────────────────────────────────────────────────────
# Lumen — environment configuration
# Loaded by:
#   • docker-compose (substitutes ${VAR} in docker-compose.yml)
#   • the Node app at runtime via dotenv (db/index.ts, server/auth.ts, etc.)
# Keep this file out of git — it's in .gitignore. Share .env.example instead.
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production


# ── Postgres (the container reads these to bootstrap itself) ────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voip_db

# Used by docker-entrypoint.sh's readiness probe.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string the app uses. When running with docker compose, the app
# container reaches the DB at host "postgres". When running the app on your
# host machine (npm run dev), point this at localhost.
#   compose:   postgresql://postgres:postgres@postgres:5432/voip_db
#   localhost: postgresql://root:toor@localhost:5432/voip_db
DATABASE_URL=postgresql://root:toor@localhost:5432/voip_db


# ── Sessions / cookies ──────────────────────────────────────────────────────
# Used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=8516e3e650901bbde3c047374770cfd583eabe62268208d3cd51364f458502d0

# Set to "true" only when serving over HTTPS (e.g. behind a TLS proxy).
# Leave empty / false for local HTTP development — otherwise the browser
# silently drops the session cookie and every API call looks unauthenticated.
SECURE_COOKIES=false


# ── Google OAuth ─ optional ─────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL.
# Leave blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# ── SMTP / mail ─ optional ──────────────────────────────────────────────────
# Used to send password-reset emails. If empty, the app logs the reset link to
# the server console (fine for development, useless in production).
# Examples for common providers:
#   Resend:   smtp.resend.com:587  user=resend pass=<api-key>
#   Mailgun:  smtp.mailgun.org:587
#   Gmail:    smtp.gmail.com:587   user=<email>  pass=<app-password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Lumen <no-reply@lumen.localhost>

# Used to build absolute URLs in password-reset emails. Defaults to
# `${req.protocol}://${req.host}` when blank.
PUBLIC_BASE_URL=


# ── Cloudflare Tunnel ─ optional, ONLY if you later buy a real domain ──────
# Leave both blank — `npm run demo` will hand you a free random
# *.trycloudflare.com HTTPS URL anyone on the internet can open. No domain,
# no DNS, no port forwarding required.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_HOSTNAME=


# ── GitHub OAuth ─ optional ─────────────────────────────────────────────────
# Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL.
# Leave blank to disable the "Continue with GitHub" button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
